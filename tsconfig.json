{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true, "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true, "skipLibCheck": true, "moduleResolution": "Node",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
