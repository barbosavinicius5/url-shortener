{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal in-memory HTTP API that creates short codes for URLs, redirects to the original URL and reports access stats.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}