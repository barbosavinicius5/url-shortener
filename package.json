{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "In-memory HTTP URL shortener API built with Node.js 20, TypeScript and Express",
  "main": "dist/server.js",
  "type": "commonjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barbosavinicius5/url-shortener.git"
  },
