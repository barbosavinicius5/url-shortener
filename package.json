{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "HTTP URL shortening and redirect service",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc",
