{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "A minimal URL shortener API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
