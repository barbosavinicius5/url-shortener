{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Minimal HTTP API to shorten URLs with in-memory storage",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
