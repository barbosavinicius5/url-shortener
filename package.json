  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.21",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}